# === AlgoTrading Configuration ===

# --- General ---
INITIAL_CAPITAL=50.0
BASE_CURRENCY=EUR

# --- Trading Mode ---
TRADING_MODE=paper  # paper | live
LIVE_TRADING_ENABLED=false
SAFE_MODE_ENABLED=false
EMERGENCY_STOP=false

# --- Broker & Data ---
BROKER_NAME=mock_broker
DATA_PROVIDER=yfinance  # mock | yfinance | kraken

# --- Time Horizon ---
TIME_HORIZON=swing  # intraday | short_term | swing | medium_term | long_term
MARKET_REFRESH_SECONDS=5

# --- Risk Management ---
MAX_POSITION_SIZE_PERCENT=0.20  # Max 20% of capital per position
MAX_DAILY_LOSS_PERCENT=0.05
MAX_MONTHLY_LOSS_PERCENT=0.15
MAX_DRAWDOWN_PERCENT=0.25

# --- Profitability Filter ---
MIN_EXPECTED_NET_RETURN_PERCENT=0.005 # Minimum expected net return 0.5% after costs
MAX_TRANSACTION_COST_PERCENT=0.05 # Transaction costs shouldn't exceed 5% of the invested amount

# --- Advanced Features ---
ENABLE_ML=false
ENABLE_SHORT=false
ENABLE_LEVERAGE=false

# --- Database ---
# For SQLite (default)
DATABASE_URL=sqlite:///data/algotrading.db
# For PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/algotrading
